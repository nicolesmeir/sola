# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_…) — the legacy anon key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; used for admin scripts (seeding). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com → API keys). Server-only.
ANTHROPIC_API_KEY=
